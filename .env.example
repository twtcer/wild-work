# wild-work Docker 外部配置模板：cp .env.example .env 后按需修改。
# （.env 已被 .gitignore 忽略，本模板入库以便新机器/新克隆直接用）
#
# 优先级：本文件（环境变量） > ./wildwork-data/config.json（面板写的就是它） > 代码默认
#        internal/config.Default()（= 桌面形态默认，下面各行的值与它一致）
# ⚠️ 写在这里的值会盖掉面板对同一项的修改（重启后生效）。
#    想把某项交回面板管理：注释掉或删掉对应行即可。
#
# 容器固定项不在本文件（改了会破坏端口映射/健康检查，定义在 docker-compose.yml / Dockerfile）：
#   TZ=Asia/Shanghai、WILDWORK_HOME=/data、WILDWORK_LISTEN=0.0.0.0:7863、
#   WILDWORK_CALLBACK_LISTEN=0.0.0.0:43903

# ── 必填：面板管理密码（容器对外监听时强制要求，见 AGENTS.md R4）──
WILDWORK_ADMIN_PASSWORD=请换成你的口令

# ── OpenAI 接口 Key（/v1/* 的 Authorization: Bearer）──
# 桌面形态默认是 WildWorkAPI；容器形态兜底默认是下面这个值，端口暴露到局域网/公网前务必改掉
WILDWORK_API_KEY=sk-8b2c1d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a

# ── 数据落点（相对路径基于容器内 WILDWORK_HOME=/data，即挂载的 ./wildwork-data）──
WILDWORK_AUTH_DIR=./auths
WILDWORK_STATE_FILE=./data/state.json

# ── 区域：cn | global（影响 WorkBuddy 系模型清单与端点）──
WILDWORK_REGION=cn

# ── 账号错误惩罚（cooldown.*）──
WILDWORK_HARD_CREDIT=12h     # 余额耗尽硬冷却
WILDWORK_SOFT_RATE=60s       # 限流软冷却
WILDWORK_ERR_THRESHOLD=3     # 连续错误次数达到即冷却
WILDWORK_ERR_COOLDOWN=10m    # 普通错误冷却时长

# ── 上游请求超时（秒；仅非流式，流式不设超时——见 AGENTS.md R35）──
WILDWORK_TIMEOUT_SECONDS=120

# ── OAuth 回调（traework / qwenwork 登录）写进 redirect_uri 的主机 ──
# 监听固定 0.0.0.0:43903（compose 已发布 127.0.0.1:43903）；
# 从别的机器打开面板登录时改成面板机器 IP
WILDWORK_CALLBACK_HOST=127.0.0.1

# ── 三接口兼容层（面板「模型路由」同源）──
WILDWORK_DEFAULT_CHANNEL=workbuddy   # 无前缀模型名的兜底渠道
WILDWORK_MAX_TOKENS_CAP=32000        # max_tokens 封顶（0 = 不限制）

# ── 构建期（仅 docker compose up --build 使用，不注入容器运行时）──
# 大陆网络：官方 proxy.golang.org 不可达时保留，否则注释掉走官方源
GOPROXY=https://goproxy.cn,direct

# ── 以下参数**没有**环境变量，只能改面板或挂载的 ./wildwork-data/config.json ──
#   schedule.checkin_times     签到时刻（默认 09:00 / 21:00）
#   schedule.keepalive_hours   保活小时（默认 22）
#   schedule.expiring_threshold_hours  临期阈值小时（默认 24，下限 24）
#   compat.model_map           模型映射表
#   proxies                    单渠道上游代理（{channel: url}）
#   面板 API Key/管理密码以外的面板开关（开机自启等）
